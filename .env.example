# Copy to .env for local development. Never commit .env.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+467XXXXXXXX

HOMEQ_SEARCH_URL=https://www.homeq.se/
# Configure selectors only after inspecting the current HomeQ search-results page.
HOMEQ_CARD_SELECTOR=
HOMEQ_TITLE_SELECTOR=
HOMEQ_PRICE_SELECTOR=
HOMEQ_AREA_SELECTOR=
HOMEQ_LINK_SELECTOR=a
HOMEQ_ALLOWED_AREAS=
HOMEQ_POLL_INTERVAL_MS=600000
HOMEQ_HEADLESS=true
HOMEQ_BASELINE_ON_FIRST_RUN=true
HOMEQ_CARD_WAIT_TIMEOUT_MS=30000
# Alert channels (comma-separated): email, callmebot, twilio
ALERT_CHANNELS=email,callmebot
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-char-app-password
ALERT_EMAIL_TO=you@gmail.com
CALLMEBOT_PHONE=+46XXXXXXXXX
CALLMEBOT_API_KEY=
